{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "meetstream": {
      "type": "streamable-http",
      "url": "https://mcp.meetstream.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            }
          }
        }
      }
    },
    "meetstream-docs": {
      "type": "streamable-http",
      "url": "https://docs.meetstream.ai/_mcp/server"
    }
  }
}
