{
 "commands": [
  {
   "path": "agent bench",
   "use": "bench",
   "short": "Measure your agent's models: tokens and cost per hour of meeting, one short real turn each",
   "flags": [
    {
     "name": "agent",
     "type": "string",
     "usage": "agent CLI: claude, codex, hermes, agy (default: your setup, or the first installed)"
    },
    {
     "name": "binary",
     "type": "string",
     "usage": "path to the agent CLI"
    },
    {
     "name": "compare",
     "type": "bool",
     "usage": "measure the models the CLI offers (default: only the model your setup uses)"
    },
    {
     "name": "effort",
     "type": "string",
     "usage": "reasoning effort for every run, where the CLI supports it"
    },
    {
     "name": "export",
     "type": "string",
     "usage": "write or merge the measurements into a model-estimates.json file (nothing is uploaded)"
    },
    {
     "name": "max-models",
     "type": "int",
     "default": "4",
     "usage": "with --compare: at most this many models"
    },
    {
     "name": "models",
     "type": "string",
     "usage": "comma-separated model ids to measure"
    },
    {
     "name": "parallel",
     "type": "int",
     "default": "4",
     "usage": "models measured at once"
    }
   ]
  },
  {
   "path": "agent context",
   "use": "context [show|edit]",
   "short": "Show what the agent reads or edit MEETING.md",
   "flags": [
    {
     "name": "agent",
     "type": "string",
     "usage": "agent (default: saved setup)"
    },
    {
     "name": "ignore-rules",
     "type": "bool",
     "usage": "show project rules as ignored where supported"
    },
    {
     "name": "workdir",
     "type": "string",
     "usage": "folder (default: saved setup)"
    }
   ]
  },
  {
   "path": "agent login",
   "use": "login",
   "short": "Connect this computer to MeetStream so MIA can reach your agent (no tunnel)",
   "flags": [
    {
     "name": "no-browser",
     "type": "bool",
     "usage": "print the sign-in link instead of opening a browser"
    }
   ]
  },
  {
   "path": "agent logout",
   "use": "logout",
   "short": "Disconnect this computer from MeetStream"
  },
  {
   "path": "agent serve",
   "use": "serve",
   "short": "Run the local bridge on 127.0.0.1",
   "flags": [
    {
     "name": "agent",
     "type": "string",
     "default": "claude",
     "usage": "agent CLI: claude, codex, hermes, copilot, muse, openclaw, agy"
    },
    {
     "name": "binary",
     "type": "string",
     "usage": "path to the agent CLI"
    },
    {
     "name": "command",
     "type": "string",
     "usage": "custom command; {prompt} is replaced, otherwise stdin"
    },
    {
     "name": "debug",
     "type": "bool",
     "usage": "log protocol message types, never their text"
    },
    {
     "name": "effort",
     "type": "string",
     "usage": "reasoning effort where supported"
    },
    {
     "name": "ignore-rules",
     "type": "bool",
     "usage": "skip project rules where the agent supports it"
    },
    {
     "name": "max-access",
     "type": "string",
     "default": "readonly",
     "usage": "highest access: readonly, confirm, full"
    },
    {
     "name": "model",
     "type": "string",
     "usage": "agent model (MIA can override)"
    },
    {
     "name": "no-meeting-md",
     "type": "bool",
     "usage": "leave MEETING.md out of meetings"
    },
    {
     "name": "no-prime",
     "type": "bool",
     "usage": "skip the warm-up turn"
    },
    {
     "name": "no-relay",
     "type": "bool",
     "usage": "self-hosted: no relay; MIA reaches the bridge through your tunnel with a pairing token"
    },
    {
     "name": "owner",
     "type": "string",
     "default": "the user",
     "usage": "your name as MIA hears it"
    },
    {
     "name": "port",
     "type": "int",
     "default": "8787",
     "usage": "loopback port"
    },
    {
     "name": "relay",
     "type": "bool",
     "usage": "require the MeetStream relay (default when this computer is connected)"
    },
    {
     "name": "timeout",
     "type": "float64",
     "default": "60",
     "usage": "stop a turn after this many seconds with no output"
    },
    {
     "name": "tunnel",
     "type": "string",
     "default": "none",
     "usage": "none, cloudflare, ngrok, or url"
    },
    {
     "name": "tunnel-url",
     "type": "string",
     "usage": "existing https address or ngrok domain"
    },
    {
     "name": "workdir",
     "type": "string",
     "default": "<current folder>",
     "usage": "folder the agent works in"
    }
   ]
  },
  {
   "path": "agent setup",
   "use": "setup",
   "short": "Set up MIA for your meetings: MeetStream hosted, your own keys, or your agent CLI on this computer",
   "flags": [
    {
     "name": "access",
     "type": "string",
     "default": "readonly",
     "usage": "the most access this computer allows: readonly (meeting only), confirm (ask first), full"
    },
    {
     "name": "agent",
     "type": "string",
     "usage": "agent CLI: claude, codex, hermes, copilot, muse, openclaw, agy (default: pick, or the first installed)"
    },
    {
     "name": "agent-config",
     "type": "string",
     "usage": "update this MIA agent instead of creating one (keeps its voice and prompts)"
    },
    {
     "name": "brain",
     "type": "string",
     "usage": "hosted/byok: the LLM as provider:model (default: the hosted catalog's default)"
    },
    {
     "name": "dry-run",
     "type": "bool",
     "usage": "print the MIA agent request and its price without sending it"
    },
    {
     "name": "ears",
     "type": "string",
     "usage": "speech to text as provider:model (default: the hosted catalog's default)"
    },
    {
     "name": "effort",
     "type": "string",
     "usage": "reasoning effort where the CLI supports it, e.g. low, medium, high (default: the CLI's own)"
    },
    {
     "name": "mode",
     "type": "string",
     "default": "local-agent",
     "usage": "how MIA runs: hosted (MeetStream keys), byok (your provider keys), local-agent (your agent CLI on this computer)"
    },
    {
     "name": "model",
     "type": "string",
     "usage": "model the agent CLI uses (default: pick, or the CLI's own default)"
    },
    {
     "name": "name",
     "type": "string",
     "usage": "name of the new MIA agent"
    },
    {
     "name": "new-agent",
     "type": "bool",
     "usage": "create a new MIA agent instead of updating the one the last setup made"
    },
    {
     "name": "no-calendar",
     "type": "bool",
     "usage": "don't offer to connect a calendar"
    },
    {
     "name": "no-start",
     "type": "bool",
     "usage": "don't offer to start serving"
    },
    {
     "name": "owner",
     "type": "string",
     "usage": "your name as it shows in meetings (default: the last setup's, else $USER)"
    },
    {
     "name": "test",
     "type": "bool",
     "usage": "run the test turn even without a terminal (--no-input, --json)"
    },
    {
     "name": "voice",
     "type": "string",
     "usage": "text to speech as provider:model (default: the hosted catalog's default)"
    },
    {
     "name": "voice-keys",
     "type": "string",
     "default": "meetstream",
     "usage": "local-agent: ears and voice on MeetStream keys (meetstream) or your own provider keys (own)"
    },
    {
     "name": "workdir",
     "type": "string",
     "usage": "folder the agent works in (default: the last setup's, else ~/MeetStream Agent)"
    }
   ]
  },
